NODE_ENV=development
PORT=4000
# API listen interface; use 127.0.0.1 for local-only and 0.0.0.0 behind a trusted deployment proxy.
API_HOST=127.0.0.1
DATABASE_URL=postgres://brick_erp_app:brick_erp_local@localhost:5432/brick_erp
SESSION_TTL_HOURS=12
# Optional account authenticator TOTP. Generate once with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# Keep this 32-byte hex key stable and in the backend secret store; changing it makes enrolled authenticator secrets unreadable.
TOTP_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# Optional Owner business assistant. Keep the API key on the backend; never add it to frontend/.env.
# Owner questions and the returned approved ERP aggregates are sent to the configured provider for an answer.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional S3-compatible private storage for loading evidence photos. If unset, local development stores photos in PostgreSQL.
# Production should configure a private bucket, HTTPS endpoint, region and least-privilege write/read credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
# Encrypted PostgreSQL backup settings. Generate a 32-byte key and store it outside this host.
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_ADMIN_DATABASE_URL=
# Optional when pg_dump/pg_restore are not on PATH.
PG_DUMP_PATH=
PG_RESTORE_PATH=
